# BloodMap NIR: production environment variables for the Docker image.
# Set these in your host's dashboard (Render, Railway, Fly.io, a VPS…), never in git.
# See docs/deployment.md.

# ── Required ────────────────────────────────────────────────────────────
APP_NAME="BloodMap NIR"
# php artisan key:generate --show   (keep it secret; changing it signs everyone out)
APP_KEY=
# The public https URL people open. The SPA and API share it.
APP_URL=https://bloodmap.example.org

DB_CONNECTION=pgsql
DB_HOST=
DB_PORT=5432
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=
# Hosted Postgres (Supabase, Neon, Render…) needs TLS.
DB_SSLMODE=require

# ── Email (needed for sign-up verification, password reset, invites) ────
# With "log", nothing is delivered and nobody can verify a new account.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@bloodmap.example.org
MAIL_FROM_NAME="${APP_NAME}"

# ── Public demo ─────────────────────────────────────────────────────────
# true = seed the fictional demo accounts and requests once, on an empty database.
SEED_DEMO_DATA=true
# Every demo account (including the two administrators) uses this password.
# The README publishes the default; change it unless you want visitors to try every role.
DEMO_PASSWORD=

# ── Optional ────────────────────────────────────────────────────────────
# AI guide (Google Gemini free tier). Questions are sent to Google.
ASSISTANT_DRIVER=articles
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash-lite

# Defaults that already suit the container:
# APP_ENV=production  APP_DEBUG=false  LOG_CHANNEL=stderr  PORT=8080
# SESSION_DRIVER=database  CACHE_STORE=database  QUEUE_CONNECTION=database
# TRUSTED_PROXIES=*      (the platform's TLS proxy; list its IPs if you know them)
# LOG_LEVEL=warning
