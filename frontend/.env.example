# Laravel API origin. Sanctum SPA cookie auth requires the SPA and API to share
# a top-level domain (localhost:5173 ↔ localhost:8000 in development).
VITE_API_URL=http://localhost:8000

# Map tiles (Leaflet). OpenStreetMap attribution is always rendered on the map.
VITE_MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
